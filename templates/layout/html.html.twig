{#
/**
 * @file
 * tamu_theme override of html.html.twig.
 *
 * Adds a sticky institutional top bar above all theme regions.
 * Edit the #tamu-top-bar section below to customize branding and links.
 */
#}
{%-
  set body_classes = [
    logged_in ? 'user-logged-in',
    not root_path ? 'path-frontpage' : 'path-' ~ root_path|clean_class,
    node_type ? 'node--type-' ~ node_type|clean_class,
    db_offline ? 'db-offline',
    'archipelago-chiloe-theme',
  ]
-%}
{%- if attributes.hasClass('page-view-browse-by-facets') %}
  {% set attributes = attributes.setAttribute('data-bs-spy', 'scroll') %}
  {% set attributes = attributes.setAttribute('data-bs-target', '.list-scrollspy') %}
  {% set attributes = attributes.setAttribute(' data-bs-smooth-scroll', 'true') %}
{% endif -%}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token|raw }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token|raw }}">
    <js-placeholder token="{{ placeholder_token|raw }}">
  </head>
  <body{{ attributes.addClass(body_classes) }}>
    <a href="#main-content" class="visually-hidden focusable skip-link">
      {{ 'Skip to main content'|t }}
    </a>

    {# ============================================================
       TAMU Institutional Top Bar
       Edit links, logo, and text here to match your institution.
       ============================================================ #}
    <div id="tamu-top-bar" role="banner" aria-label="Institutional header">
      <div class="tamu-top-bar__inner">
        <a href="https://www.tamu.edu" class="tamu-top-bar__brand" target="_blank" rel="noopener">
          <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <path d="M60.98 0H13.5c-1.67 0-3.02 1.35-3.02 3.02s1.35 3.02 3.02 3.02h40.18L.89 58.84a3.018 3.018 0 0 0 0 4.27 3.018 3.018 0 0 0 4.27 0l52.79-52.79V50.5c0 1.67 1.35 3.02 3.02 3.02s3.02-1.35 3.02-3.02V3.02c0-1.67-1.35-3.02-3.02-3.02Z" style="stroke-width:0"/>
          </svg>
          <span class="tamu-top-bar__wordmark">Texas A&amp;M University</span>
        </a>
        <nav class="tamu-top-bar__nav" aria-label="Institutional links">
          <a href="https://library.tamu.edu/askus" class="tamu-top-bar__link">Help</a>
          <a href="https://library.tamu.edu/about/hours" class="tamu-top-bar__link">Hours</a>
          <a href="https://library.tamu.edu/mylibrary/" class="tamu-top-bar__link">My Library</a>
          <div class="tamu-top-bar__dropdown dropdown">
            <button type="button" class="tamu-top-bar__button dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <path d="M58.44 18.46 32.87.33c-.52-.37-1.21-.37-1.73 0L5.56 18.46c-.4.28-.63.74-.63 1.22v8.91c0 .83.67 1.5 1.5 1.5h.89v23.5h-.89c-.83 0-1.5.67-1.5 1.5v7.39c0 .83.67 1.5 1.5 1.5h51.14c.83 0 1.5-.67 1.5-1.5v-7.39c0-.83-.67-1.5-1.5-1.5h-.89v-23.5h.89c.83 0 1.5-.67 1.5-1.5v-8.91c0-.49-.24-.94-.63-1.22Zm-2.37 8.63H7.93V22.7h48.14v4.39ZM33.5 53.59v-23.5h8.59v23.5H33.5Zm-11.59 0v-23.5h8.59v23.5h-8.59ZM32 3.39l22.99 16.3H9.01L32 3.39Zm-21.68 26.7h8.59v23.5h-8.59v-23.5Zm45.75 30.89H7.93v-4.39h48.14v4.39Zm-2.39-7.39h-8.59v-23.5h8.59v23.5ZM32 9.37c-2.31 0-4.19 1.88-4.19 4.19s1.88 4.19 4.19 4.19 4.19-1.88 4.19-4.19S34.31 9.37 32 9.37Zm0 5.37c-.65 0-1.19-.53-1.19-1.19s.53-1.19 1.19-1.19 1.19.53 1.19 1.19-.53 1.19-1.19 1.19Z" style="stroke-width:0"/>
              </svg>
              Libraries
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-label="Libraries">
              <li><a class="dropdown-item" href="https://library.tamu.edu/cushing/index.html" target="_blank" rel="noopener">Cushing Memorial Library &amp; Archives</a></li>
              <li><a class="dropdown-item" href="https://library.tamu.edu/galveston/index.html" target="_blank" rel="noopener">Jack K. Williams Library - Galveston</a></li>
              <li><a class="dropdown-item" href="https://library.tamu.edu/medical-sciences/index.html" target="_blank" rel="noopener">Medical Sciences Library</a></li>
              <li><a class="dropdown-item" href="https://library.tamu.edu/index.html" target="_blank" rel="noopener">Sterling C. Evans Library &amp; Annex</a></li>
              <li><a class="dropdown-item" href="https://library.tamu.edu/wcl/index.html" target="_blank" rel="noopener">West Campus Library</a></li>
            </ul>
          </div>
          <div class="tamu-top-bar__dropdown dropdown">
            <button type="button" class="tamu-top-bar__button dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <path d="M31.98-.02c-17.68 0-32 14.32-32 32s14.32 32 32 32 32-14.33 32-32-14.33-32-32-32ZM30.5 20.36c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v.74c0 .83-.67 1.5-1.5 1.5s-1.5-.67-1.5-1.5v-.74Zm5.39 24.78H28.1c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5h2.39V28.21H28.1c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5h3.89c.83 0 1.5.67 1.5 1.5v15.43h2.39c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5Z" style="stroke-width:0"/>
              </svg>
              Information For
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-label="Information For">
              <li><a class="dropdown-item" href="https://library.tamu.edu/about/undergraduates" target="_blank" rel="noopener">Undergraduates</a></li>
              <li><a class="dropdown-item" href="https://library.tamu.edu/about/graduates" target="_blank" rel="noopener">Graduates</a></li>
              <li><a class="dropdown-item" href="https://library.tamu.edu/about/faculty" target="_blank" rel="noopener">Faculty</a></li>
              <li><a class="dropdown-item" href="https://library.tamu.edu/about/disabilities" target="_blank" rel="noopener">Individuals with Disabilities</a></li>
            </ul>
          </div>
        </nav>

        {# Mobile menu toggle. Lives here rather than in the navbar so that
           #navbar-top has nothing left to render on small screens — it was
           showing as an empty white strip. Targets the same .to-be-collapsed
           panels as the theme's own toggler, which header.css hides below lg. #}
        <button class="tamu-top-bar__menu-toggle" type="button"
                data-bs-toggle="collapse" data-bs-target=".to-be-collapsed"
                aria-controls="CollapsingNavbarTop CollapsingNavbar"
                aria-expanded="false" aria-label="{{ 'Toggle navigation'|t }}">
          <span class="tamu-top-bar__menu-icon" aria-hidden="true"></span>
        </button>
      </div>
    </div>
    {# ============================================================ #}

    {# ============================================================
       Site identity — site title + TAMU logo lockup, white band
       between the institutional bar and the primary nav.
       ============================================================ #}
    <div class="tamu-site-identity">
      <div class="tamu-site-identity__inner">
        <div class="tamu-site-identity__title">
          <a href="{{ path('<front>') }}">Digital Collections</a>
        </div>
        <div class="tamu-site-identity__logo">
          <a aria-label="Texas A&amp;M University Link" href="https://www.tamu.edu" target="_blank" rel="noopener">
            <img alt="Texas A&amp;M University" src="https://aux.tamu.edu/logos/primaryTAM.png">
          </a>
        </div>
      </div>
    </div>
    {# ============================================================ #}

    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token|raw }}">
  </body>
</html>
