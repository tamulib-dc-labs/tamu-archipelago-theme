<article{{ attributes }}>

  {# ── Hero ── #}
  <div class="tamu-collection-hero" style="background-image: url('https://digitalcollections.library.tamu.edu/iiif/2/f8c%2Fimage-berger-60846bdd-cc8c-48fa-974b-57bc5d478859.jpg/full/1400,/0/default.jpg'); background-size: cover; background-position: center;">
    <div class="tamu-collection-hero__overlay">
      <div class="container">
        <h1 class="tamu-collection-hero__title">Browse and Search</h1>
      </div>
    </div>
  </div>

  {# ── Body ── #}
  <div class="container tamu-about-body">
    {{ title_suffix }}
     <section class="tamu-about-body__section">
      <h3>Browse and Search Digital Collections Site</h3>
      <div class="tamu-cards-grid">
        <a href="/collections" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/49e%2Fimage-utf-8-cmlrsc00189-d2e7bcd2-09fa-4737-8e50-1412aac0e24a.jp2/full/400,/0/default.jpg" alt="thumbnail for browse by collection"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Browse by Collection</h3>
            <p class="tamu-card__description">Browse items by individual collections</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="/search?search_api_fulltext=" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/2f8%2Fimage-utf-8-cmljwc0284-2d24918f-83a0-4a81-bc5e-677ce776dbd3.jp2/full/400,/0/default.jpg" alt="thumbnail for browse by item"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Browse by Item</h3>
            <p class="tamu-card__description">Browse all items and filter with search facets</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
      </div>
      <h3>Browse Other Repositories</h3>
      <div class="tamu-cards-grid">
        <a href="https://avalon.library.tamu.edu" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/6a5%2Fimage-utf-8-poster-9fe98cb0-387c-4306-a4a1-12d5d257d650.jpeg/full/400,/0/default.jpg" alt="avalon thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Audio and Video</h3>
            <p class="tamu-card__description">Browse audio and video materials</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://newspaper.library.tamu.edu" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://library.tamu.edu/collections/images/tx-aggie-news.jpg" alt="Newspaper Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Newspapers</h3>
            <p class="tamu-card__description">Browse periodicals such as The Battalion, The Texas Aggie, The Daily Bulletin/Reveille and The Texas Polka News in our Newspaper Collection</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://findingaids.library.tamu.edu" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/0b5%2Fimage-bryan-e2822e8f-b3a6-4c89-b665-ca22a516fb93.jpg/full/400,/0/default.jpg" alt="A.M.C. Early Presidents Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Archival Finding Aids</h3>
            <p class="tamu-card__description">Search finding aids of physical archival materials</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://catalog.library.tamu.edu" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/d5b%2Fimage-service-maps-0010-0001-3de62ab0-254c-484a-9c44-70b2a91d846a.jp2/full/400,/0/default.jpg" alt="thumbnail for search library catalog"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Library Catalog/h3>
            <p class="tamu-card__description">Search the general library catalog for print and digital materials</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
      </div>
    </section>
  </div>
</article>
