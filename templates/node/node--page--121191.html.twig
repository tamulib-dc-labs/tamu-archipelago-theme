<article{{ attributes }}>

  {# ── Hero ── #}
  <div class="tamu-collection-hero" style="background-image: url('https://digitalcollections.library.tamu.edu/iiif/2/f8c%2Fimage-berger-60846bdd-cc8c-48fa-974b-57bc5d478859.jpg/full/1400,/0/default.jpg'); background-size: cover; background-position: center;">
    <div class="tamu-collection-hero__overlay">
      <div class="container">
        <h1 class="tamu-collection-hero__title">Digital Exhibits</h1>
      </div>
    </div>
  </div>

  {# ── Body ── #}
  <div class="container tamu-about-body">
    {{ title_suffix }}
    <div class="tamu-about-body__intro">
      <h2>Explore our digital exhibits</h2>
      <p>Texas A&M Digital Collections contains various digital exhibits made of digitized materials from Cushing and partners of the Libraries.</p> 
    </div>

  <section class="tamu-about-body__section">
      <h2>Collecting Areas</h2>
      <h3>University Archives</h3>
      <div class="tamu-cards-grid">

        <a href="https://spotlight.library.tamu.edu/spotlight/charting-texas" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/86d%2Fimage-charting-63bc35b0-a68c-4d74-a1f9-3e7c50b709fa.jpg/full/400,/0/default.jpg " alt="Charting Texas Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Charting Texas</h3>
            <p class="tamu-card__description">Features maps and books, documenting several centuries of exploration and political competition for one specific area of North America – Texas</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://spotlight.library.tamu.edu/spotlight/london-collection" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/c07%2Fimage-london-18375bc7-f682-4663-bf9b-bb1cddafd513.jpg/full/400,/0/default.jpg" alt="London Collection Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Stephen Powys Marks London Collection</h3>
            <p class="tamu-card__description">Views of London ranging from original maps and plans from the 18th to the 20th centuries, and facsimiles from the 16th and 17th centuries.</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://spotlight.library.tamu.edu/spotlight/scifi-exhibit-2021" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/d22%2Fimage-lorax-0e7efb41-72b3-455f-ac4c-2f1365da9d74.jpg/full/400,/0/default.jpg" alt="Live to Build a Better World Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Live to Build a Better World: Despair, Survival, and Hope in Science Fiction’s Response to Environmental Change</h3>
            <p class="tamu-card__description">This digital collection reflects the content of an exhibit presented at Cushing Memorial Library & Archives from January - June 2021</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://spotlight.library.tamu.edu/spotlight/austin-map" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/aef%2Fimage-texas-map-c400fd83-9c24-4b11-a205-b9a34461ede4.jpg/full/400,/0/default.jpg" alt="Austin Map Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Stephen F. Austin's 1830 Map of Texas</h3>
            <p class="tamu-card__description">This first edition of Stephen F. Austin’s 1830 Map of Texas is often described as “the first meaningful map of Texas” and was the first to accurately depict the rivers in Texas and illustrate many of the early settlements including Brazoria, Gonzales, Harrisburg, Matagorda, Victoria and Waco Village.</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://spotlight.library.tamu.edu/spotlight/william-fairfax-gray-diary" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/aef%2Fimage-texas-map-c400fd83-9c24-4b11-a205-b9a34461ede4.jpg/full/400,/0/default.jpg" alt="Portrait of William Fairfax Gray"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">William Fairfax Gray Diary</h3>
            <p class="tamu-card__description">William Fairfax Gray’s diary offers one of the most vivid firsthand accounts of the founding of the Republic of Texas, capturing both the political turbulence of the Convention of 1836 and the human experiences behind it.</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://spotlight.library.tamu.edu/spotlight/bryan-150-exhibit" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/b5c%2Fimage-lamar-1-9966249d-ed7c-4fa9-b247-82d271682ec1.jpg/full/400,/0/default.jpg" alt="150 Years and Counting Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">150 Years and Counting: Celebrating 150 Years of the City of Bryan, Texas</h3>
            <p class="tamu-card__description">This digital exhibit highlights the architecture and growth of the city, from a rural settlement to a flourishing city and seat of Brazos County.</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://spotlight.library.tamu.edu/spotlight/alice-in-wonderland" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/3ea%2Fimage-alice-14ae1337-4da7-43e4-b78a-00c7048832c1.jpg/full/400,/0/default.jpg" alt="Alice in Wonderland Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">“Who in the world am I? Ah, that’s the great puzzle!”: The Faces of Alice in Wonderland</h3>
            <p class="tamu-card__description">This exhibit features images of Alice from artists all over the world, starting with Alice's original illustrator Sir John Tenniel.</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
      </div>
    </section>
  </div>
</article>
