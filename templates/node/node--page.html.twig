<article{{ attributes }}>

  <div class="tamu-collection-hero" style="background-image: url('https://digitalcollections.library.tamu.edu/iiif/2/254%2Fimage-service-maps-0073-0001-017588c9-f068-441f-87e0-ebcec298f4c5.jp2/full/1200,/0/default.jpg');">
    <div class="tamu-collection-hero__overlay">
      <div class="container">
        <h1 class="tamu-collection-hero__title">{{ label }}</h1>
      </div>
    </div>
  </div>

  <div class="container" style="max-width: 860px; padding: 2rem 1.5rem;">
    {{ title_suffix }}
    <div class="node__content">
      {{ content.body }}
    </div>
  </div>

</article>
