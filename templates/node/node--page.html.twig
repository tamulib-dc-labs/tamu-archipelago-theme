<article{{ attributes }}>

  <div class="tamu-collection-hero tamu-collection-hero--no-image">
    <div class="tamu-collection-hero__overlay">
      <div class="container">
        <h1 class="tamu-collection-hero__title">{{ label }}</h1>
      </div>
    </div>
  </div>

  <div class="container" style="max-width: 860px; padding: 2rem 1.5rem;">
    {{ title_suffix }}
    <div class="node__content">
      {{ content.body }}
    </div>
  </div>

</article>
