{#
 * Hero layout for digital_object_collection nodes via Display Suite.
 * DS uses view mode "collection_listing" for full node pages.
 * Builds the hero image URL directly from JSON to avoid double-rendering.
#}
{% set node_entity = node ?? drupal_entity('node', attributes['data-history-node-id']) %}
{% set iiif_base = drupal_config('format_strawberryfield.iiif_settings', 'pub_server_url')|trim('/') %}
{% set hero_src = '' %}
{% set hero_alt = '' %}

{% if node_entity %}
  {% set raw_json = node_entity.field_descriptive_metadata.value %}
  {% if raw_json %}
    {% set metadata = raw_json|sbf_json_decode %}
    {% set hero_alt = metadata.label ?? node_entity.label %}
    {% if metadata['as:image'] is defined %}
      {% set img_obj = metadata['as:image']|first %}
      {% if img_obj and img_obj.url is defined %}
        {% set encoded = img_obj.url|replace({'s3://': '', 'private://': ''})|url_encode %}
        {% set hero_src = iiif_base ~ '/' ~ encoded ~ '/full/1400,/0/default.jpg' %}
      {% endif %}
    {% elseif metadata['as:document'] is defined %}
      {% for doc in metadata['as:document'] %}
        {% if hero_src == '' and doc['flv:exif'] is defined and doc['flv:exif'].MIMEType == 'application/pdf' %}
          {% set encoded = doc.url|replace({'s3://': '', 'private://': ''})|url_encode %}
          {% set hero_src = iiif_base ~ '/' ~ encoded ~ ';1/full/1400,/0/default.jpg' %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endif %}
{% endif %}

<div{{ attributes.addClass('node node--type-digital-object-collection') }}>

  {# ── Hero ────────────────────────────────────────────────────────────────── #}
  <div class="tamu-collection-hero{% if not hero_src %} tamu-collection-hero--no-image{% endif %}">
    {% if hero_src %}
      <div class="tamu-collection-hero__image">
        <img src="{{ hero_src }}" alt="{{ hero_alt }}" class="tamu-collection-hero__img">
      </div>
    {% endif %}
    <div class="tamu-collection-hero__overlay">
      <div class="container">
        <h1 class="tamu-collection-hero__title">{{ node_entity ? node_entity.label|raw : node.label|raw }}</h1>
        {% if content.body is defined %}
          {% set body_text = content.body|render|striptags|trim %}
          {% if body_text is not empty %}
            <div class="tamu-collection-hero__description">{{ content.body }}</div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  {# ── Metadata below hero ─────────────────────────────────────────────────── #}
  {{ title_prefix }}
  {{ title_suffix }}
  <div class="container tamu-collection-meta">
    <div class="row">
      <div class="col-md-12">
        {{ content.ds_content }}
      </div>
    </div>
  </div>

</div>
