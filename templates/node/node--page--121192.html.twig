<article{{ attributes }}>

  {# ── Hero ── #}
  <div class="tamu-collection-hero" style="background-image: url('https://digitalcollections.library.tamu.edu/iiif/2/f8c%2Fimage-berger-60846bdd-cc8c-48fa-974b-57bc5d478859.jpg/full/1400,/0/default.jpg'); background-size: cover; background-position: center;">
    <div class="tamu-collection-hero__overlay">
      <div class="container">
        <h1 class="tamu-collection-hero__title">Sesquicentennial Collections</h1>
      </div>
    </div>
  </div>

  {# ── Body ── #}
  <div class="container tamu-about-body">
    {{ title_suffix }}
    <div class="tamu-about-body__intro">
      <h2>Explore collections by collecting area</h2>
      <p>Texas A&M Digital Collections contains digitized versions of items from across Cushing's various collecting areas.</p> 
      <p>For more information about the scope of each collecting area, read at our <a href="https://library.tamu.edu/cushing/about/cushing-policies/collection-policies/index.html">Collecting Policies</a>.</p>
    </div>
    <section class="tamu-about-body__section">
      <div class="tamu-cards-grid">

        <a href="/amc-early-presidents" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/0b5%2Fimage-bryan-e2822e8f-b3a6-4c89-b665-ca22a516fb93.jpg/full/400,/0/default.jpg" alt="A.M.C. Early Presidents Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">A.M.C. Early Presidents Collection</h3>
            <p class="tamu-card__description">Contains papers and correspondence from five presidents of the Agricultural and Mechanical College of Texas in the late 1800s</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>

        <a href="/oral-histories" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/730%2Fimage-3445116737-716868a802-o-8604a50c-15ef-41e0-a807-f486ff100905.jpg/full/400,/0/default.jpg" alt="Oral Histories Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Oral Histories Collection</h3>
            <p class="tamu-card__description">Gathers the stories behind the university’s history: the arrivals, traditions, challenges, relationships, and turning points remembered by the people who lived them</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="/tamu-building-history" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/709%2Fimage-academic-d8e7a0eb-916e-41b4-9b38-a7eba93e5985.jpg/full/400,/0/default.jpg" alt="Texas A&M Building History Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Texas A&M Building History Collection</h3>
            <p class="tamu-card__description">Showcases images of Texas A&M buildings from the late 1800s until the present day</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://innovation.library.tamu.edu/aggieland-through-time/" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://digitalcollections.library.tamu.edu/iiif/2/f37%2Fimage-att-academicbuilding-019-edit-7b0d1e3d-bdfb-4056-b6c9-54e8584255b9.jp2/full/full/0/default.jpg" alt="Texas A&M Building History Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Aggieland Through Time Interactive Map</h3>
            <p class="tamu-card__description">Navigate through time with our dynamic mapping system that visualizes the physical growth and architectural evolution of campus</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
        <a href="https://150.tamu.edu/university-timeline/index.html" class="tamu-card">
          <div class="tamu-card__image">
            <img src="https://150.tamu.edu/assets/images/timeline/1947-1968/1957-reveille-ii.jpg" alt="Texas A&M Building History Thumbnail"/>
          </div>
          <div class="tamu-card__body">
            <h3 class="tamu-card__title">Texas A&M History Timeline</h3>
            <p class="tamu-card__description">Explore key moments in Aggie history</p>
            <span class="tamu-card__link">View collection</span>
          </div>
        </a>
      </div>
    </section>
  </div>
</article>
