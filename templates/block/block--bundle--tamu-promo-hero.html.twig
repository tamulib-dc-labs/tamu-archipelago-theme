{#
  Tamu promo band block — headline, body copy, CTA link.

  Fields expected on the "Tamu Promo Hero" block type:
    field_promo_heading — Text (plain)
    field_promo_body    — Text (long)
    field_promo_cta_url — Link field (URL + title)
#}
{{ attach_library('tamu_theme/promo-band') }}

<div{{ attributes.addClass('tamu-promo-band') }}>

  <div class="tamu-promo-band__inner">

    {% if elements.field_promo_heading %}
      <h2 class="tamu-promo-band__heading">
        {{ elements.field_promo_heading[0]['#context']['value'] }}
      </h2>
    {% endif %}

    {% if elements.field_promo_body %}
      <div class="tamu-promo-band__body">
        {{ elements.field_promo_body }}
      </div>
    {% endif %}

    {% if elements.field_promo_cta_url %}
      {% set cta = elements.field_promo_cta_url[0] %}
      <a href="{{ cta['#url'] }}" class="tamu-promo-band__cta">
        {{ cta['#title'] }}
      </a>
    {% endif %}

  </div>

</div>
