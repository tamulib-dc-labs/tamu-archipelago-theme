<?php

/**
 * @file
 * TAMU Theme — child theme of archipelago_subtheme_chiloe.
 *
 * Add preprocess hooks here as needed.
 */

/**
 * Pass node URL to DS layout templates so tamu-card can wrap with a link.
 */
function tamu_theme_preprocess_ds_1col(&$variables) {
  $elements = $variables['elements'] ?? [];
  // Only run for the card view mode to avoid affecting other DS 1col layouts.
  if (($elements['#view_mode'] ?? '') !== 'digital_object_with_thumbnail_for_grid') {
    return;
  }
  // DS stores the entity as #node or #entity depending on version.
  $node = $elements['#node'] ?? $elements['#entity'] ?? NULL;
  if ($node instanceof \Drupal\node\NodeInterface) {
    $variables['node_url'] = $node->toUrl()->toString();
  }
}

/**
 * Add SAML login link to the user login form.
 */
function tamu_theme_form_user_login_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $return_to = \Drupal::request()->query->get('returnTo', 'user');
  $saml_url = \Drupal\Core\Url::fromUserInput('/saml/drupal_login/netid_login', [
    'query' => ['returnTo' => $return_to],
  ])->toString();

  $form['saml_login'] = [
    '#type' => 'markup',
    '#markup' => '<div class="saml-login-link"><a href="' . $saml_url . '" class="btn btn-primary mt-2">Login with TAMU NetID</a></div>',
    '#weight' => -10,
  ];
}

/**
 * Add "Featured on front page" checkbox to Digital Object Collection edit form.
 */
function tamu_theme_form_node_digital_object_collection_edit_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $node = $form_state->getFormObject()->getEntity();
  $form['tamu_promote'] = [
    '#type' => 'checkbox',
    '#title' => t('Featured on front page'),
    '#description' => t('Check to display this collection in the Featured Collections section on the home page.'),
    '#default_value' => (bool) $node->get('promote')->value,
    '#weight' => -10,
    '#group' => 'advanced',
  ];
  $form['actions']['submit']['#submit'][] = 'tamu_theme_promote_node_submit';
}

/**
 * Submit handler to save the promote value.
 */
function tamu_theme_promote_node_submit($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $node = $form_state->getFormObject()->getEntity();
  $node->set('promote', (int) $form_state->getValue('tamu_promote'));
  $node->save();
}

/**
 * Add "Featured on front page" checkbox to Digital Object edit form.
 */
function tamu_theme_form_node_digital_object_edit_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $node = $form_state->getFormObject()->getEntity();
  $form['tamu_promote'] = [
    '#type' => 'checkbox',
    '#title' => t('Featured on front page'),
    '#description' => t('Check to display this item in the Featured Works section on the home page.'),
    '#default_value' => (bool) $node->get('promote')->value,
    '#weight' => -10,
    '#group' => 'advanced',
  ];
  $form['actions']['submit']['#submit'][] = 'tamu_theme_promote_node_submit';
}

/**
 * Add node ID to theme suggestions so node--TYPE--NID.html.twig templates work.
 */
function tamu_theme_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  $suggestions[] = 'node__' . $node->bundle() . '__' . $node->id();
}

/**
 * Fix aria label for search.
 */
function tamu_theme_form_views_exposed_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if (isset($form['search_api_fulltext'])) {
    $form['search_api_fulltext']['#title'] = t('Search');
    $form['search_api_fulltext']['#title_display'] = 'invisible';
  }
  tamu_theme_advanced_search_form_alter($form);
  tamu_theme_search_inside_form_alter($form, $form_state);
}

/**
 * "Search inside" pages, under Advanced Searches in the main menu.
 *
 * Two displays of the solr_search_content view list text hits grouped by
 * the object they belong to: /search_websites (page_2) archived web pages,
 * /search_pages (page_3) OCR'd book and document pages. They get the
 * /advanced-search form panel and the /search result cards
 * (css/search-inside.css) through the views_view__search_inside and
 * views_bootstrap_grid__search_inside templates.
 *
 * @return string|null
 *   'web' or 'pages' for those displays, NULL for anything else.
 */
function tamu_theme_search_inside_kind($view) {
  if (!$view instanceof \Drupal\views\ViewExecutable || $view->id() !== 'solr_search_content') {
    return NULL;
  }
  return ['page_2' => 'web', 'page_3' => 'pages'][$view->current_display] ?? NULL;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view.
 */
function tamu_theme_theme_suggestions_views_view_alter(array &$suggestions, array $variables) {
  if (tamu_theme_search_inside_kind($variables['view'] ?? NULL)) {
    $suggestions[] = 'views_view__search_inside';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_bootstrap_grid.
 */
function tamu_theme_theme_suggestions_views_bootstrap_grid_alter(array &$suggestions, array $variables) {
  if (tamu_theme_search_inside_kind($variables['view'] ?? NULL)) {
    $suggestions[] = 'views_bootstrap_grid__search_inside';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function tamu_theme_preprocess_views_view(&$variables) {
  $variables['search_inside'] = tamu_theme_search_inside_kind($variables['view'] ?? NULL);
}

/**
 * Implements hook_preprocess_HOOK() for views_bootstrap_grid.
 */
function tamu_theme_preprocess_views_bootstrap_grid(&$variables) {
  $variables['search_inside'] = tamu_theme_search_inside_kind($variables['view'] ?? NULL);
}

/**
 * Implements hook_preprocess_HOOK() for views_view_field.
 *
 * Hit labels and snippets on the "search inside" pages: page hits are
 * labelled "Sequence N" and link to page N, so they read "Page N", as the
 * page chips on /search do; web archive text carries literal "\n" marks.
 */
function tamu_theme_preprocess_views_view_field(&$variables) {
  if (!tamu_theme_search_inside_kind($variables['view'] ?? NULL)) {
    return;
  }
  $field = $variables['field']->options['id'] ?? '';
  $output = (string) $variables['output'];
  if ($field === 'sbf_label') {
    $output = preg_replace('/>\s*Sequence (\d+)\s*</', '>Page $1<', $output);
  }
  elseif ($field === 'sbf_plaintext') {
    $output = str_replace('\n', ' ', $output);
  }
  else {
    return;
  }
  $variables['output'] = \Drupal\Core\Render\Markup::create($output);
}

/**
 * The search box on the "search inside" pages: a visible label, which
 * heads the form panel, and a hint of what to type.
 */
function tamu_theme_search_inside_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $kind = tamu_theme_search_inside_kind($form_state->get('view'));
  $key = ['web' => 'search_api_fulltext', 'pages' => 'page_text'][$kind] ?? NULL;
  if (!$key || !isset($form[$key])) {
    return;
  }
  $form['#attributes']['class'][] = 'tamu-search-inside__form';
  $form[$key]['#title'] = $kind === 'web' ? t('Search inside web archives') : t('Search inside book and document pages');
  $form[$key]['#title_display'] = 'before';
  $form[$key]['#attributes']['placeholder'] = $kind === 'web' ? t('Words or a web address') : t('Words in the page text');
}

/**
 * Advanced search (Strawberryfield "Advanced Fulltext search" filter).
 *
 * The filter renders each row as a fieldset, "{id}_wrapper" for the first
 * and "{id}_wrapper_{n}" for the rest, holding the AND/OR group operator,
 * the match operator, the search words and the searched-field select, in
 * that order. Rows read here as "Search in [field] [match] [words]", so the
 * children are re-weighted, which moves them in the DOM and keeps the tab
 * order the same as the visual one.
 *
 * Chiloé swaps every exposed-form select for a Bootstrap dropdown over a
 * hidden input. The filter's Classic Mode script clears and shifts rows
 * through `select[name^=…]` and data-advanced-search-type, which the swap
 * drops, so these selects opt out with data-convert="no" and stay native.
 */
function tamu_theme_advanced_search_form_alter(array &$form) {
  $rows = [];
  foreach (\Drupal\Core\Render\Element::children($form) as $key) {
    if (preg_match('/_wrapper(_(\d+))?$/', $key, $m) && tamu_theme_advanced_search_is_row($form[$key])) {
      $rows[$key] = isset($m[2]) ? (int) $m[2] : 0;
    }
  }
  if (!$rows) {
    return;
  }
  $form['#attributes']['class'][] = 'tamu-advanced-search';
  tamu_theme_advanced_search_date_alter($form);

  foreach ($rows as $key => $index) {
    $row = &$form[$key];
    $row['#attributes']['class'][] = 'tamu-adv-row';
    // Labels show once, over the first row; the others carry them for
    // screen readers only.
    $display = $index === 0 ? 'before' : 'invisible';
    foreach (\Drupal\Core\Render\Element::children($row) as $child) {
      $element = &$row[$child];
      $type = $element['#attributes']['data-advanced-search-type'] ?? NULL;
      if ($type === 'op' || $type === 'group_op') {
        $element['#title'] = t('Combine with');
        $element['#title_display'] = 'invisible';
        $element['#weight'] = -10;
        $element['#attributes']['data-convert'] = 'no';
      }
      elseif ($type === 'fields') {
        $element['#title'] = t('Search in');
        $element['#title_display'] = $display;
        $element['#weight'] = -5;
        $element['#attributes']['data-convert'] = 'no';
      }
      elseif ($type === 'boolean') {
        $element['#title'] = t('Match');
        $element['#title_display'] = $display;
        $element['#weight'] = -4;
        $element['#attributes']['data-convert'] = 'no';
        // "Contains all of these words" under a "Match" heading leaves the
        // search words too little room; the values stay the same.
        $short = [
          'and' => t('All of these words'),
          'or' => t('Any of these words'),
          'not' => t('None of these words'),
        ];
        foreach ($element['#options'] ?? [] as $value => $label) {
          if (isset($short[$value])) {
            $element['#options'][$value] = $short[$value];
          }
        }
      }
      elseif (($element['#type'] ?? '') === 'textfield') {
        $element['#title'] = t('Search words');
        $element['#title_display'] = $display;
        $element['#weight'] = -3;
        $element['#attributes']['placeholder'] = t('Enter search words');
      }
      unset($element);
    }
    unset($row);
  }
}

/**
 * Advanced search "Date" filter: Date created (original), "Is between",
 * exposed as "date" on the advanced_search view.
 *
 * Search API reads the values with strtotime(), which takes a bare year
 * such as "1950" as a time of day (19:50 today). People type years, so a
 * four-digit year becomes 1 January (From) or 31 December (To), and a
 * range with only one end filled in is left open at the other.
 */
function tamu_theme_advanced_search_date_alter(array &$form) {
  $date = NULL;
  if (isset($form['date']['min'], $form['date']['max'])) {
    $date = &$form['date'];
  }
  elseif (isset($form['date_wrapper']['date']['min'], $form['date_wrapper']['date']['max'])) {
    $date = &$form['date_wrapper']['date'];
  }
  if ($date === NULL) {
    return;
  }
  if (isset($form['date_wrapper'])) {
    $form['date_wrapper']['#attributes']['class'][] = 'tamu-adv-date';
  }
  else {
    $date['#attributes']['class'][] = 'tamu-adv-date';
  }
  foreach (['min' => t('From year'), 'max' => t('To year')] as $end => $label) {
    $date[$end]['#title'] = $label;
    $date[$end]['#title_display'] = 'invisible';
    $date[$end]['#size'] = 10;
    $date[$end]['#attributes']['placeholder'] = $label;
    $date[$end]['#attributes']['inputmode'] = 'numeric';
    $date[$end]['#attributes']['data-tamu-adv-date'] = $end;
  }
  $date['#element_validate'][] = 'tamu_theme_advanced_search_date_validate';
}

/**
 * Element validate: years to dates, one-sided ranges left open.
 */
function tamu_theme_advanced_search_date_validate(array &$element, \Drupal\Core\Form\FormStateInterface $form_state) {
  $value = $form_state->getValue($element['#parents']);
  if (!is_array($value)) {
    return;
  }
  $min = trim((string) ($value['min'] ?? ''));
  $max = trim((string) ($value['max'] ?? ''));
  if ($min === '' && $max === '') {
    return;
  }
  if (preg_match('/^\d{4}$/', $min)) {
    $min .= '-01-01';
  }
  if (preg_match('/^\d{4}$/', $max)) {
    $max .= '-12-31';
  }
  $value['min'] = $min === '' ? '0001-01-01' : $min;
  $value['max'] = $max === '' ? '9999-12-31' : $max;
  $form_state->setValueForElement($element, $value);
}

/**
 * Whether a form element is an advanced search row: it holds the
 * searched-field select the filter marks data-advanced-search-type="fields".
 */
function tamu_theme_advanced_search_is_row($element) {
  if (!is_array($element)) {
    return FALSE;
  }
  foreach (\Drupal\Core\Render\Element::children($element) as $child) {
    if (($element[$child]['#attributes']['data-advanced-search-type'] ?? NULL) === 'fields') {
      return TRUE;
    }
  }
  return FALSE;
}
